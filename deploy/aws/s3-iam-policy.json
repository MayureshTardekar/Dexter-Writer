{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DexterS3LeastPrivilegeAccess",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:ListBucket",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::dexter-write-storage",
        "arn:aws:s3:::dexter-write-storage/*"
      ]
    }
  ]
}

