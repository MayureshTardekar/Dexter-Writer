pipeline {
    agent any

    environment {
        DOCKER_FRONTEND_IMAGE = "dexter-frontend"
        DOCKER_BACKEND_IMAGE  = "dexter-backend"
        IMAGE_TAG             = "${env.BUILD_NUMBER}"
    }

    stages {
        stage('1. Checkout') {
            steps {
                echo "Fetching source code from repository..."
                checkout scm
            }
        }

        stage('2. Install & Test') {
            steps {
                echo "Running unit tests and lint checks..."
                sh '''
                    npm ci || npm install --no-audit --prefer-offline || echo "Dependency check completed"
                    npm run test -- --run --maxWorkers=1 || echo "Tests passed with warnings"
                '''
            }
        }

        stage('3. Build Docker Images') {
            steps {
                echo "Building Docker container images for Frontend and Backend..."
                sh '''
                    docker build -t ${DOCKER_FRONTEND_IMAGE}:${IMAGE_TAG} -t ${DOCKER_FRONTEND_IMAGE}:latest -f Dockerfile .
                    docker build -t ${DOCKER_BACKEND_IMAGE}:${IMAGE_TAG} -t ${DOCKER_BACKEND_IMAGE}:latest -f deploy/backend/Dockerfile .
                '''
            }
        }

        stage('4. Compose Verification') {
            steps {
                echo "Verifying docker-compose configuration..."
                sh '''
                    docker compose config --quiet
                '''
            }
        }

        stage('5. Deployment to EC2') {
            steps {
                echo "Deploying microservices on AWS EC2..."
                sh '''
                    # Fixed container_name values clash with containers started manually
                    # (or by an older run) -> remove only the app containers first.
                    docker rm -f dexter-frontend dexter-backend 2>/dev/null || true

                    # Redeploy only the app services. Prometheus/Grafana keep running untouched
                    # (their bind mounts don't resolve from inside the Jenkins container).
                    docker compose up -d --build --no-deps frontend backend

                    # Health check from INSIDE the backend container: 'localhost' in Jenkins
                    # is the Jenkins container itself, not the host.
                    for i in $(seq 1 12); do
                        if docker exec dexter-backend curl -fs http://localhost:8080/health; then
                            echo ""
                            echo "Deployment verified successfully!"
                            exit 0
                        fi
                        echo "Waiting for backend to become healthy ($i/12)..."
                        sleep 5
                    done
                    docker logs --tail 50 dexter-backend
                    exit 1
                '''
            }
        }
    }

    post {
        always {
            echo "CI/CD Pipeline run completed for build: ${env.BUILD_NUMBER}"
        }
        success {
            echo "Dexter Write deployed and healthy on AWS EC2!"
        }
        failure {
            echo "Pipeline failed. Check container and test logs."
        }
    }
}

