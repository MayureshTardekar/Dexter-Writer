# Dexter Write — Environment Configuration

# Optional: AWS Lambda LaTeX Compiler Function URL (for 0 MB instant cloud compilation)
# e.g. https://xxxx.lambda-url.us-east-1.on.aws/
VITE_LATEX_LAMBDA_URL=

# Optional: Supabase cloud sync + remote MCP connector.
# Leave both blank to keep Dexter Write fully local.
# Project URL: Supabase dashboard -> Project Settings -> API -> Project URL
VITE_SUPABASE_URL=
# Public anon key: safe to ship in the browser bundle; RLS protects the data.
VITE_SUPABASE_ANON_KEY=

# Set to "off" to disable the app-closed Lambda compile path entirely.
# Compilation still works in the browser. Default: "on".
VITE_COMPILE_CLOUD=on

# Server-only secrets. Set these with `supabase secrets set`, not in the
# browser bundle. The mcp Edge Function reads LATEX_LAMBDA_URL when the model
# calls dexter_compile_document.
# LATEX_LAMBDA_URL=https://xxxx.lambda-url.ap-south-1.on.aws/
# COMPILE_CLOUD=off
